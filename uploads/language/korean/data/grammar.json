  {
   "id": "g-past",
   "title": "Past tense: 았어요 / 었어요",
   "rule": "Past tense: take the polite form, drop 요, add ㅆ under the last syllable, then 어요 (가요 → 갔어요, 먹어요 → 먹었어요, 해요 → 했어요, 더워요 → 더웠어요). 이다 becomes 이었어요.",
   "type": "forms",
   "kinds": [
    "past"
   ]
